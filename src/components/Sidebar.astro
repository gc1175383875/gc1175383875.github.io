---
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import IconHome from "@/assets/icons/IconHome.svg";
import IconArticle from "@/assets/icons/IconArticle.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";

const { pathname } = Astro.url;
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const navItems = [
  { href: "/", label: "Home", icon: IconHome },
  { href: "/posts", label: "Posts", icon: IconArticle },
  { href: "/tags", label: "Tags", icon: IconHash },
  { href: "/archives", label: "Archives", icon: IconArchive },
  { href: "/about", label: "About", icon: IconUser },
];

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<aside id="sidebar" aria-label="Sidebar">
  <header class="profile-wrapper">
    <a href="/" id="avatar" class="rounded-circle">
      <img
        src="/astropaper-og.jpg"
        alt="avatar"
        width="112"
        height="112"
        onerror="this.style.display='none'"
      />
    </a>
    <h1 class="site-title">
      <a href="/">{SITE.title}</a>
    </h1>
    <p class="site-subtitle">{SITE.desc}</p>
  </header>

  <nav class="sidebar-nav">
    <ul>
      {navItems.map((item) => (
        <li class:list={["nav-item", { active: isActive(item.href) }]}>
          <a href={item.href} class="nav-link">
            <item.icon class="nav-icon" />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar-bottom">
    <a href="/search" aria-label="Search" title="Search">
      <IconSearch class="social-icon" />
    </a>
    {SITE.lightAndDarkMode && (
      <button
        id="sidebar-theme-btn"
        class="theme-toggle"
        aria-label="Switch Mode"
        title="Toggle theme"
      >
        <IconMoon class="icon-moon" />
        <IconSunHigh class="icon-sun" />
      </button>
    )}
    {SOCIALS.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.name}
        title={social.name}
      >
        <social.icon class="social-icon" />
      </a>
    ))}
  </div>
</aside>

<div id="sidebar-mask"></div>

<style>
  #sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: 200px;
    z-index: 99;
    background: var(--background);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, width 0.6s ease;
  }

  #sidebar::-webkit-scrollbar {
    display: none;
  }

  #sidebar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .profile-wrapper {
    padding: 2.5rem 2rem 1.5rem;
    text-align: center;
  }

  #avatar {
    display: inline-block;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--border) 0 0 0 2px;
  }

  #avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  #avatar:hover img {
    transform: scale(1.2);
  }

  .site-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }

  .site-title a {
    color: var(--foreground);
    text-decoration: none;
  }

  .site-title a:hover {
    color: var(--accent);
  }

  .site-subtitle {
    font-size: 0.875rem;
    color: var(--foreground);
    opacity: 0.7;
    margin: 0;
  }

  .sidebar-nav {
    flex: 1;
    padding: 0 1rem;
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin-bottom: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--foreground);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.2s;
  }

  .nav-link:hover {
    background-color: var(--muted);
  }

  .nav-item.active .nav-link {
    color: var(--accent);
    background-color: var(--muted);
  }

  .nav-icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 1rem;
    opacity: 0.8;
  }

  .nav-link span {
    font-size: 0.9rem;
  }

  .sidebar-bottom {
    padding: 1rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .sidebar-bottom a {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--foreground);
    background-color: var(--muted);
    transition: background-color 0.2s, color 0.2s;
  }

  .sidebar-bottom a:hover {
    background-color: var(--accent);
    color: var(--background);
  }

  .theme-toggle {
    position: relative;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--foreground);
    background-color: var(--muted);
    border: none;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .theme-toggle:hover {
    background-color: var(--accent);
    color: var(--background);
  }

  .theme-toggle .icon-moon,
  .theme-toggle .icon-sun {
    position: absolute;
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s, opacity 0.3s;
  }

  .theme-toggle .icon-moon {
    transform: scale(1);
    opacity: 1;
  }

  .theme-toggle .icon-sun {
    transform: scale(0);
    opacity: 0;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-moon {
    transform: scale(0);
    opacity: 0;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-sun {
    transform: scale(1);
    opacity: 1;
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
  }

  #sidebar-mask {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 98;
    opacity: 0;
    transition: opacity 0.3s;
  }

  @media (max-width: 849px) {
    #sidebar {
      transform: translateX(-200px);
    }

    #sidebar.open {
      transform: translateX(0);
    }

    #sidebar-mask.show {
      display: block;
      opacity: 1;
    }
  }

  @media (min-width: 1200px) {
    #sidebar {
      width: 300px;
    }
  }
</style>

<script>
  function initSidebarTheme() {
    const themeBtn = document.getElementById('sidebar-theme-btn');
    
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
    });
  }

  initSidebarTheme();
  document.addEventListener('astro:after-swap', initSidebarTheme);
</script>
